From 746fe9d2d7d7a56bfded3784704f9997b7791a51 Mon Sep 17 00:00:00 2001
From: Marco Luzzaro <marcoluzzaro99@gmail.com>
Date: Tue, 6 Oct 2026 13:26:20 +0200
Subject: [PATCH 2/4] fix(logger): keep logger alive during static destruction

patchbay::get() registers its static instance before logger::get() is first
called, so on exit the logger is destroyed first. ~patchbay then sends quit to
the worker thread, which logs through the destroyed logger (SIGSEGV in
spdlog::logger::log_it_).

Leak the logger instead so it outlives every other static.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/logger.cpp | 10 +++-------
 1 file changed, 3 insertions(+), 7 deletions(-)

diff --git a/src/logger.cpp b/src/logger.cpp
index 5b3faaa..3e01bd4 100644
--- a/src/logger.cpp
+++ b/src/logger.cpp
@@ -94,13 +94,9 @@ namespace vencord
 
     logger &logger::get()
     {
-        static std::unique_ptr<logger> instance;
-
-        if (!instance)
-        {
-            instance = std::unique_ptr<logger>(new logger);
-        }
-
+        // Intentionally leaked: the patchbay singleton is destroyed during static destruction as well, and its worker
+        // thread still logs while shutting down. Destroying the logger first would cause a use-after-free on exit.
+        static auto *const instance = new logger;
         return *instance;
     }
 } // namespace vencord
