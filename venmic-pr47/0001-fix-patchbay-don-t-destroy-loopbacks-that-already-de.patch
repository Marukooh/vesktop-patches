From 6bb51482c48dc8703346fa3926beb19c0e217632 Mon Sep 17 00:00:00 2001
From: Marco Luzzaro <marcoluzzaro99@gmail.com>
Date: Tue, 6 Oct 2026 13:18:22 +0200
Subject: [PATCH 1/4] fix(patchbay): don't destroy loopbacks that already
 destroyed themselves

libpipewire-module-loopback schedules its own destruction once one of its
streams becomes unconnected (e.g. the captured application exits). venmic kept
the raw pw_impl_module pointer and destroyed it again in del_global/cleanup,
causing a use-after-free SIGSEGV in pw_impl_module_destroy.

Track the module's destroy event and forget the pointer when PipeWire frees it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 private/patchbay.impl.hpp | 20 ++++++++++++++++-
 src/patchbay.impl.cpp     | 47 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 66 insertions(+), 1 deletion(-)

diff --git a/private/patchbay.impl.hpp b/private/patchbay.impl.hpp
index c6a5eb0..7c159f0 100644
--- a/private/patchbay.impl.hpp
+++ b/private/patchbay.impl.hpp
@@ -43,6 +43,24 @@ namespace vencord
         std::vector<pw::link> links;
     };
 
+    class loopback
+    {
+        struct state;
+
+      private:
+        std::unique_ptr<state> m_state;
+
+      public:
+        loopback(pw::impl::mod);
+
+      public:
+        loopback(loopback &&) noexcept;
+        loopback &operator=(loopback &&) noexcept;
+
+      public:
+        ~loopback();
+    };
+
     enum class clean : std::uint8_t
     {
         without_mic = 0,
@@ -70,7 +88,7 @@ namespace vencord
 
       private:
         std::optional<share_node> virt_mic;
-        std::unordered_map<std::uint32_t, pw::impl::mod> virt_links;
+        std::unordered_map<std::uint32_t, loopback> virt_links;
 
       private:
         std::unordered_map<std::uint32_t, pw::node_info> nodes;
diff --git a/src/patchbay.impl.cpp b/src/patchbay.impl.cpp
index a44dbc7..47743dd 100644
--- a/src/patchbay.impl.cpp
+++ b/src/patchbay.impl.cpp
@@ -11,11 +11,58 @@
 
 #include <glaze/glaze.hpp>
 
+#include <pipewire/impl-module.h>
+
 namespace vencord
 {
     using enum logger::level;
     using namespace std::chrono_literals;
 
+    struct loopback::state
+    {
+        pw_impl_module *module;
+        spa_hook hook;
+        pw_impl_module_events events;
+    };
+
+    // `libpipewire-module-loopback` schedules its own destruction once one of its streams becomes unconnected (e.g. the
+    // captured application went away). We have to keep track of that, otherwise we end up destroying it a second time.
+    loopback::loopback(pw::impl::mod module) : m_state(std::make_unique<state>())
+    {
+        m_state->module = std::move(module).release();
+
+        spa_zero(m_state->hook);
+        spa_zero(m_state->events);
+
+        m_state->events.version = PW_VERSION_IMPL_MODULE_EVENTS;
+        m_state->events.destroy = [](void *data)
+        {
+            auto *const self = static_cast<state *>(data);
+
+            spa_hook_remove(&self->hook);
+            spa_zero(self->hook);
+
+            self->module = nullptr;
+        };
+
+        pw_impl_module_add_listener(m_state->module, &m_state->hook, &m_state->events, m_state.get());
+    }
+
+    loopback::loopback(loopback &&) noexcept = default;
+
+    loopback &loopback::operator=(loopback &&) noexcept = default;
+
+    loopback::~loopback()
+    {
+        if (!m_state || !m_state->module)
+        {
+            return;
+        }
+
+        spa_hook_remove(&m_state->hook);
+        pw_impl_module_destroy(std::exchange(m_state->module, nullptr));
+    }
+
     patchbay::impl::impl()
     {
         auto [pw_sender, pw_receiver] = pw::channel<pw_recipe>();
-- 
